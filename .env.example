# Copy to .env and adjust. The .env file is git-ignored; never commit real values.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
# Needed behind HTTPS on a public domain, e.g. https://feedback.example.kz
CSRF_TRUSTED_ORIGINS=

# --- Demo ---
# 1: role switcher instead of a login, the demo clock and the "reset data" button.
DEMO_MODE=1
# 1: escalation and the integration dispatcher run in a thread of the web process.
# 0: run `python manage.py worker` as a separate process instead.
INLINE_WORKER=1

# --- Country settings (the working-day calendar itself is edited in the admin panel) ---
APP_TIME_ZONE=Asia/Almaty
APP_LANGUAGE=ru

# --- Links in external notifications ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Telegram (the only real external integration; leave empty to run without it) ---
# Create a bot with @BotFather, put its token and username here, then switch the
# integration on at /integrations/ as the administrator.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
